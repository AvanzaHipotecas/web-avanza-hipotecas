<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve sitemap and robots directly as static files
  RewriteRule ^sitemap\.xml$ - [L,T=application/xml]
  RewriteRule ^robots\.txt$ - [L,T=text/plain]

  # React Router fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Default: don't let any cache (browser or shared/CDN) serve a stale
  # index.html — its filename never changes but the hashed assets it
  # references do, so a cached index.html can point at files that no
  # longer exist after a deploy.
  Header set Cache-Control "no-cache, must-revalidate"

  # Hashed, content-addressed assets: safe to cache for a long time and
  # immutably, since a content change always produces a new filename.
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
